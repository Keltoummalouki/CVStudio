import { fileURLToPath } from "node:url";
import react from "@vitejs/plugin-react";
import { defineConfig } from "vitest/config";

const fromRoot = (path: string) => fileURLToPath(new URL(path, import.meta.url));

export default defineConfig({
  plugins: [react()],
  resolve: {
    alias: {
      "@": fromRoot("./src"),
      "@messages": fromRoot("./messages"),
      // The real package throws outside React Server Components; tests run server modules directly.
      "server-only": fromRoot("./tests/utils/server-only-stub.ts"),
    },
  },
  test: {
    environment: "jsdom",
    setupFiles: ["./tests/setup.ts"],
    include: ["tests/unit/**/*.test.{ts,tsx}"],
    css: false,
    restoreMocks: true,
    unstubEnvs: true,
    coverage: {
      provider: "v8",
      include: ["src/**/*.{ts,tsx}"],
      exclude: [
        // Route shells are async Server Components: the Playwright suite renders them.
        "src/app/**/{page,layout,loading,error,not-found,global-error}.tsx",
        // shadcn/ui primitives, generated by its CLI.
        "src/components/ui/**",
        // Generated by `pnpm db:types`, and type declarations.
        "src/lib/supabase/database.types.ts",
        "src/types/**",
      ],
      reporter: ["text-summary", "html", "lcov", "json-summary"],
      // A ratchet just under the measured coverage: CI fails when it drops.
      // Raise these as tests are added; never lower them to make a change pass.
      thresholds: {
        statements: 80,
        branches: 73,
        functions: 72,
        lines: 82,
        // Server code enforces ownership and validation: it stays thoroughly tested.
        "src/features/*/server/**": { statements: 95, branches: 88, functions: 100, lines: 98 },
        "src/app/api/**": { statements: 98, branches: 90, functions: 100, lines: 98 },
        "src/lib/auth/**": { statements: 95, branches: 92, functions: 100, lines: 95 },
      },
    },
    server: {
      deps: {
        // next-intl imports "next/navigation" without an extension, which strict
        // Node ESM resolution rejects; letting Vite transform it resolves the path.
        inline: ["next-intl"],
      },
    },
  },
});
