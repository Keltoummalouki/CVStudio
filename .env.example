# Copy to .env.local and fill in values from the local stack (`pnpm db:start`,
# then `pnpm db:seed` prints them) or from a DEVELOPMENT Supabase project.
# Never commit .env.local. Never put production credentials here.
# Step-by-step setup: README.md, "Getting started".

# Public values: safe for the browser, still protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values must NEVER use the NEXT_PUBLIC_ prefix.
# IANA time zone used to display timestamps such as "last saved" (default: UTC),
# for example Europe/Paris.
APP_TIME_ZONE=UTC

# Optional: the browser binary used for PDF export outside Vercel. Unset, the
# app uses Playwright's Chromium, then the installed Chrome or Edge.
# PDF_CHROMIUM_PATH=

# AI providers for job-post analysis and tailored CVs (server only). The primary
# answers first; the other takes over only when the primary is unavailable
# (timeout, rate limit, overload or no connection). groq (default) or gemini.
# AI stays off until the owner turns it on in Settings → AI features.
AI_PRIMARY_PROVIDER=groq

# Groq API key (console.groq.com). Leave empty to use Gemini alone. Turn on Zero
# Data Retention in the Groq console's Data Controls.
GROQ_API_KEY=
# A Groq model with strict structured outputs (default openai/gpt-oss-20b).
GROQ_MODEL=openai/gpt-oss-20b

# Gemini API key, used as the fallback. Use a key from a Google Cloud project with
# billing enabled; leave empty to run without a fallback.
GEMINI_API_KEY=

# Local development and tests only: 1 answers AI requests with deterministic
# fakes instead of calling Groq or Google. Ignored on Vercel.
# AI_FAKE_PROVIDER=1
